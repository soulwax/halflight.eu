# Drizzle
# Replace with your DB credentials!
# Recommended for most uses
DATABASE_URL=postgresql://

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=postgresql://

PORT="4555"
ORIGIN="http://localhost:4555"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:4555/api/auth/github/callback"
TIDAL_CLIENT_ID=""
TIDAL_CLIENT_SECRET="="
TIDAL_REDIRECT_URI="http://localhost:4555/tidal/callback"
TIDAL_SCOPES="user.read recommendations.read search.read search.write collection.read collection.write playlists.read playlists.write playback entitlements.read"
TIDAL_TOKEN_ENC_KEY=""

ADMIN_USERNAME=""
ADMIN_PASSWORD=""

STREAMRIP_WORKER_TOKEN=""

# Separate database/schema owned by this worker. Do not point this at the app's
# Drizzle migration database until schema ownership has been deliberately unified.
SYN_WORKER_DATABASE_URL=postgresql://

# For uses requiring a connection without pgbouncer
SYN_WORKER_DATABASE_URL_UNPOOLED=postgresql://

SMTP_HOST="127.0.0.1"
SMTP_PORT="25"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Admin <noreply@youremail.domain.com>"
# Shared only between Syn's server and this private worker; 32+ random bytes.
SYN_WORKER_INTERNAL_TOKEN=""

# S3-compatible object store. Media bytes never live on the worker filesystem or in PostgreSQL.
HALFLIGHT_EXPORT_BUCKET=""
HALFLIGHT_EXPORT_BUCKET_REGION="auto"
HALFLIGHT_EXPORT_TOKEN=""
# Optional for MinIO or another S3-compatible service.
HALFLIGHT_EXPORT_BUCKET_ENDPOINT="https://"
HALFLIGHT_EXPORT_BUCKET_ACCESS_KEY_ID=""
HALFLIGHT_EXPORT_BUCKET_SECRET_ACCESS_KEY=""

# Optional, separate S3-compatible bucket for music files you own and upload.
# TIDAL media, artwork, lyrics, and provider files must never be uploaded here.
HALFLIGHT_PRIVATE_MUSIC_BUCKET=""
HALFLIGHT_STORAGE_BUCKET_ENDPOINT="https://"
HALFLIGHT_PRIVATE_MUSIC_BUCKET_REGION="auto"
HALFLIGHT_PRIVATE_MUSIC_BUCKET_ACCESS_KEY_ID=""
HALFLIGHT_PRIVATE_MUSIC_BUCKET_SECRET_ACCESS_KEY=""
HALFLIGHT_PRIVATE_MUSIC_BUCKET_TOKEN=""

HALFLIGHT_TIDAL_CACHE_ENABLED=true
HALFLIGHT_TIDAL_CACHE_BUCKET=""
HALFLIGHT_TIDAL_CACHE_BUCKET_ENDPOINT="https://"
HALFLIGHT_TIDAL_CACHE_BUCKET_REGION="auto"
HALFLIGHT_TIDAL_CACHE_BUCKET_TOKEN=""
HALFLIGHT_TIDAL_CACHE_BUCKET_ACCESS_KEY_ID=""
HALFLIGHT_TIDAL_CACHE_BUCKET_SECRET_ACCESS_KEY=""


LASTFM_API_KEY=""
LASTFM_APPLICATION_NAME=""
LASTFM_REGISTERED_TO=""
LASTFM_SHARED_SECRET=""

REDIS_CACHE="redis://default:pass@yourdomain.com:6379/0"

NPMJS_TOKEN="npm_"
ADMIN_GITHUB_ID=
