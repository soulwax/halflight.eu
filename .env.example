# Drizzle
# Replace with your DB credentials!
# Recommended for most uses
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Port the self-hosted (adapter-node / PM2) server listens on. Ignored on Vercel
# and by `pnpm dev`. See ecosystem.config.cjs.
PORT="3000"

# The exact public base URL, scheme included. Better Auth matches requests and
# builds OAuth callbacks from this — in production it MUST be your https:// URL,
# not http://, or sign-in and the /api/auth/* routes break.
ORIGIN="http://localhost:3000"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET="replace-with-32-char-high-entropy-secret"

# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
# Set this exact callback URL in the GitHub OAuth App. For production use:
# https://your-domain.com/api/auth/callback/github

# Halflight administrator (single user)
# Use your GitHub login as ADMIN_USERNAME. It is matched case-insensitively.
ADMIN_USERNAME="your-github-username"
ADMIN_PASSWORD="replace-with-a-long-unique-password"

# Postfix / SMTP email delivery. Point SMTP_HOST at the local Postfix listener
# (typically 127.0.0.1) or your authenticated relay. Verification is required
# before a password account can use Halflight. Production mail is sent as
# noreply@adminmail.bluesix.dev; Postfix must accept only local/authenticated submission.
SMTP_HOST="127.0.0.1"
SMTP_PORT="25"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="Halflight <noreply@adminmail.bluesix.dev>"

# Optional local Redis for server-only caches, coordination, and secondary pending-queue buffering.
# Encode reserved characters in the username/password portion of the URL.
REDIS_CACHE="redis://default:your-redis-password@127.0.0.1:6379/0"

# Optional, isolated S3-compatible bucket for owner-requested playlist exports.
# Export objects are served only through authenticated Syn endpoints and expire after 15 minutes.
# Do not use the TIDAL worker/media bucket here.
HALFLIGHT_EXPORT_BUCKET=""
HALFLIGHT_EXPORT_BUCKET_ENDPOINT=""
HALFLIGHT_EXPORT_BUCKET_REGION="auto"
HALFLIGHT_EXPORT_BUCKET_ACCESS_KEY_ID=""
HALFLIGHT_EXPORT_BUCKET_SECRET_ACCESS_KEY=""

# Optional, separate S3-compatible bucket for music files you own and upload
# (MP3, FLAC, AAC/M4A, Ogg, WAV, and WebM; 128 MiB per file, 512 MiB total).
# TIDAL media, artwork, lyrics, and provider files must never be uploaded here.
HALFLIGHT_PRIVATE_MUSIC_BUCKET=""
HALFLIGHT_PRIVATE_MUSIC_BUCKET_ENDPOINT=""
HALFLIGHT_PRIVATE_MUSIC_BUCKET_REGION="auto"
HALFLIGHT_PRIVATE_MUSIC_BUCKET_ACCESS_KEY_ID=""
HALFLIGHT_PRIVATE_MUSIC_BUCKET_SECRET_ACCESS_KEY=""

# Optional, isolated cache for short-lived completed TIDAL HiRes assemblies.
# Leave disabled unless provider permission and bucket lifecycle deletion have both been verified.
# This must not reuse the private-music, export, or worker/media bucket.
HALFLIGHT_TIDAL_CACHE_ENABLED="false"
HALFLIGHT_TIDAL_CACHE_BUCKET=""
HALFLIGHT_TIDAL_CACHE_BUCKET_ENDPOINT=""
HALFLIGHT_TIDAL_CACHE_BUCKET_REGION="auto"
HALFLIGHT_TIDAL_CACHE_BUCKET_ACCESS_KEY_ID=""
HALFLIGHT_TIDAL_CACHE_BUCKET_SECRET_ACCESS_KEY=""

# Last.fm scrobbling. The shared secret and optional encryption key are server-only.
LASTFM_API_KEY="your-lastfm-api-key"
LASTFM_APPLICATION_NAME="Halflight"
LASTFM_REGISTERED_TO="your-lastfm-account"
LASTFM_SHARED_SECRET="your-lastfm-shared-secret"
# Optional; uses a key derived from BETTER_AUTH_SECRET when omitted.
LASTFM_TOKEN_ENC_KEY=""

# Tidal OAuth (personal, single-user)
# Register an app at https://developer.tidal.com. Set its redirect URI to match
# TIDAL_REDIRECT_URI *exactly*, and grant it the scopes listed below.
TIDAL_CLIENT_ID="your-tidal-client-id"
# Required only for a confidential app (one issued a client secret).
TIDAL_CLIENT_SECRET="your-tidal-client-secret"
# Must be registered verbatim in the TIDAL app settings. In prod, point at your domain.
TIDAL_REDIRECT_URI="http://localhost:3000/tidal/callback"
# Space-separated OAuth scopes to request (start minimal, add write scopes later).
TIDAL_SCOPES="user.read recommendations.read search.read search.write collection.read collection.write playlists.read playlists.write playback entitlements.read"
# 32-byte key, base64-encoded, used to encrypt the stored token record at rest.
# Generate with: openssl rand -base64 32
# Keep this STABLE — changing it makes every previously stored token undecryptable.
TIDAL_TOKEN_ENC_KEY="generate-with-openssl-rand-base64-32"
