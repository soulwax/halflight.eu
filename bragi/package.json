{
  "name": "bragi-cli",
  "version": "0.1.0",
  "description": "Friendly audio inspection, downloads, WAV conversion and browser playback powered by bragi-audio",
  "type": "module",
  "license": "MIT",
  "author": "soulwax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soulwax/bragi-cli.git"
  },
  "homepage": "https://github.com/soulwax/bragi-cli#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.21.0",
  "bin": {
    "bragi": "./dist/cli.js",
    "bragi-cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm test:browser",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "bragi-audio": "0.2.2",
    "commander": "15.0.0",
    "@clack/prompts": "1.8.1",
    "env-paths": "4.0.0",
    "open": "11.0.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.5.2",
    "@playwright/test": "1.60.0",
    "eslint": "10.0.1",
    "esbuild": "0.28.2",
    "globals": "17.6.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vitest": "4.1.8"
  },
  "bugs": {
    "url": "https://github.com/soulwax/bragi-cli/issues"
  }
}
