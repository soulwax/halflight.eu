{
	"name": "syn",
	"private": true,
	"version": "0.3.5",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build:vercel": "vite build",
		"build:node": "ADAPTER=node vite build",
		"build": "ADAPTER=node vite build",
		"start": "node --env-file=.env build/index.js",
		"preview": "vite preview",
		"pm2:start": "pnpm db:migrate && pnpm build:node && pm2 start ecosystem.config.cjs",
		"pm2:reload": "pnpm db:migrate && pnpm build:node && pm2 reload ecosystem.config.cjs --update-env",
		"pm2:stop": "pm2 stop ecosystem.config.cjs",
		"pm2:delete": "pm2 delete ecosystem.config.cjs",
		"pm2:logs": "pm2 logs syn",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint --cache --cache-location node_modules/.cache/eslint/ .",
		"lint:types": "eslint --config eslint.config.typed.js --cache --cache-location node_modules/.cache/eslint-typed/ src/",
		"format": "prettier --write .",
		"test:unit": "vitest run --project client --project server",
		"test:server": "vitest run --project server",
		"test:storybook": "vitest run --project storybook",
		"test": "pnpm test:unit && pnpm test:storybook && pnpm test:e2e",
		"test:e2e": "playwright install && playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"go": "pnpm i && pnpm pm2:reload",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@chromatic-com/storybook": "latest",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.60.0",
		"@storybook/addon-a11y": "^10.5.10",
		"@storybook/addon-docs": "^10.5.10",
		"@storybook/addon-svelte-csf": "latest",
		"@storybook/addon-vitest": "^10.5.10",
		"@storybook/sveltekit": "^10.5.10",
		"@sveltejs/adapter-node": "6.0.0-next.10",
		"@sveltejs/adapter-vercel": "7.0.0-next.8",
		"@sveltejs/kit": "3.0.0-next.25",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/nodemailer": "^8.0.1",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.8",
		"auth": "^1.6.23",
		"better-auth": "^1.6.23",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.5.10",
		"eslint-plugin-svelte": "^3.19.0",
		"fast-check": "^4.9.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.7",
		"playwright": "^1.60.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"storybook": "^10.5.10",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1127.0",
		"@lucide/svelte": "^1.38.0",
		"bits-ui": "^2.19.0",
		"nodemailer": "^9.1.1",
		"redis": "^6.2.1",
		"bragi-audio": "0.2.2",
		"svelte-dnd-action": "^0.9.79",
		"valibot": "^1.4.2",
		"web-haptics": "^0.0.6"
	}
}
